{
  "manifest_version": 3,
  "name": "ChatGPT Text Bookmarker",
  "version": "1.5.0",
  "description": "Bookmark specific sentences, paragraphs, formulas, or code snippets inside ChatGPT responses and scroll back to the exact passage.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle ChatGPT Bookmarks Sidebar"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "selectors.js",
        "storage.js",
        "identity.js",
        "health.js",
        "anchorEngine.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
